/** Drobe temporary API. Deploy as Web App (execute as owner, access anyone). */
const TABLES={users:['id','email','password_hash','name','avatar_url','created_at'],sessions:['token','user_id','expires_at'],closets:['id','user_id','name','is_default','created_at'],items:['id','user_id','closet_id','name','category','color','brand','season','tags_json','original_image_url','processed_image_url','processing_status','purchase_url','price','purchased_at','is_favorite','condition','notes','created_at','updated_at'],outfits:['id','user_id','name','thumbnail_url','items_json','created_at'],diary:['id','user_id','outfit_id','wear_date','created_at'],trips:['id','user_id','name','start_date','end_date','destination','created_at'],trip_items:['id','trip_id','clothing_item_id','packed']};
function setupSheets(){Object.keys(TABLES).forEach(function(n){var s=sheet_(n);s.getRange(1,1,1,TABLES[n].length).setValues([TABLES[n]]);s.setFrozenRows(1)});return out_({success:true,message:'Drobe tables ready'})}
function doGet(e){try{var p=e&&e.parameter||{};if(p.action==='setup')return setupSheets();if(p.action==='health')return out_({success:true,status:'ok'});return out_({success:true,data:dispatch_(p)})}catch(x){return out_({success:false,error:String(x.message||x)})}}
function doPost(e){try{var b=JSON.parse(e&&e.postData&&e.postData.contents||'{}');if(b.action==='setup')return setupSheets();return out_({success:true,data:dispatch_(b)})}catch(x){return out_({success:false,error:String(x.message||x)})}}
function dispatch_(b){setupSheets();var a=String(b.action||'');if(a==='register')return register_(b);if(a==='login')return login_(b);if(a==='refresh')return session_(b.token);if(a==='logout')return {success:true};var u=require_(b.token);if(a==='change_password')return changePassword_(b,u);if(a==='closets_list')return rows_('closets').filter(function(x){return x.user_id===u.id}).map(closet_);if(a==='closet_create')return closetCreate_(b,u);if(a==='closet_delete')return deleteOwned_('closets',b.id,u.id);if(a==='items_list')return itemsList_(b,u);if(a==='item_create')return itemCreate_(b,u);if(a==='item_update')return itemUpdate_(b,u);if(a==='item_delete')return deleteOwned_('items',b.id,u.id);if(a==='items_stats')return stats_(u);if(a==='weather')return {weather:{temperature:25,condition:'clear',description:'Thời tiết hiện tại'},recommendation:'Chọn outfit thoải mái cho hôm nay.',suggestedItems:[],suggestedOutfits:[]};if(a==='analyze')return {name:'',category:'top',color:'',brand:'',season:'all',tags:[],condition:'new'};if(a==='rembg')return {imageBase64:b.imageBase64||''};if(a==='outfits_list')return outfits_(u);if(a==='outfit_create')return outfitCreate_(b,u);if(a==='outfit_delete')return deleteOwned_('outfits',b.id,u.id);if(a==='diary_list')return diary_(u);if(a==='diary_upsert')return diaryUpsert_(b,u);if(a==='diary_delete')return deleteOwned_('diary',b.id,u.id);if(a==='trips_list')return trips_(u);if(a==='trip_create')return tripCreate_(b,u);if(a==='trip_delete')return deleteOwned_('trips',b.id,u.id);if(a==='trip_item_add')return tripItemAdd_(b,u);if(a==='trip_item_delete')return tripItemDelete_(b.id,u.id);if(a==='trip_item_toggle')return tripItemToggle_(b.id,u.id);if(a==='ai_chat')return {message:'AI Stylist đang ở chế độ tạm thời. Hãy chọn một món đồ trong tủ để bắt đầu.'};throw Error('Unknown action: '+a)}
function register_(b){var e=String(b.email||'').trim().toLowerCase();if(!e||!b.password)throw Error('Email and password are required.');if(find_('users','email',e))throw Error('Email already exists.');var u={id:Utilities.getUuid(),email:e,password_hash:hash_(b.password),name:String(b.name||e.split('@')[0]),avatar_url:'',created_at:now_()};add_('users',u);return loginSession_(u)}
function login_(b){var u=find_('users','email',String(b.email||'').trim().toLowerCase());if(!u||u.password_hash!==hash_(b.password||''))throw Error('Invalid email or password.');return loginSession_(u)}
function loginSession_(u){var t=Utilities.getUuid()+Utilities.getUuid().replace(/-/g,'');add_('sessions',{token:t,user_id:u.id,expires_at:new Date(Date.now()+30*86400000).toISOString()});return {accessToken:t,user:user_(u)}}
function session_(t){return {accessToken:t,user:user_(require_(t))}}
function changePassword_(b,u){var r=find_('users','id',u.id);if(r.password_hash!==hash_(b.currentPassword||''))throw Error('Current password is incorrect.');r.password_hash=hash_(b.newPassword||'');update_('users',r.id,r);return {message:'Password changed.'}}
function closetCreate_(b,u){var list=rows_('closets').filter(function(x){return x.user_id===u.id});var r={id:Utilities.getUuid(),user_id:u.id,name:String(b.name||'Tủ đồ chính'),is_default:list.length===0,created_at:now_()};add_('closets',r);return closet_(r)}
function itemsList_(b,u){var a=rows_('items').filter(function(x){return x.user_id===u.id&&(!b.closetId||x.closet_id===b.closetId)}).map(item_);a.sort(function(x,y){return String(y.createdAt).localeCompare(String(x.createdAt))});return {items:a,pagination:{total:a.length,page:1,limit:Number(b.limit||1000),totalPages:1}}}
function itemCreate_(b,u){var image=b.imageData||b.imageUrl||'';if(b.imageData)image=saveImage_(b.imageData,b.imageName||'item-'+Date.now()+'.png');var r={id:Utilities.getUuid(),user_id:u.id,closet_id:b.closetId||'',name:String(b.name||'Món đồ mới'),category:b.category||'top',color:b.color||'',brand:b.brand||'',season:b.season||'all',tags_json:JSON.stringify(array_(b.tags)),original_image_url:image,processed_image_url:'',processing_status:'done',purchase_url:b.purchaseUrl||'',price:b.price==null?'':b.price,purchased_at:b.purchasedAt||'',is_favorite:false,condition:b.condition||'new',notes:b.notes||'',created_at:now_(),updated_at:now_()};add_('items',r);return item_(r)}
function itemUpdate_(b,u){var r=owned_('items',b.id,u.id);Object.keys(b.data||{}).forEach(function(k){var n=snake_(k);if(TABLES.items.indexOf(n)>=0&&n!=='id'&&n!=='user_id')r[n]=n==='tags_json'?JSON.stringify(array_(b.data[k])):b.data[k]});r.updated_at=now_();update_('items',r.id,r);return item_(r)}
function stats_(u){var a=rows_('items').filter(function(x){return x.user_id===u.id}),by={},byValue={},colors={};a.forEach(function(x){by[x.category]=(by[x.category]||0)+1;byValue[x.category]=(byValue[x.category]||0)+Number(x.price||0);colors[x.color||'Khác']=(colors[x.color||'Khác']||0)+1});return {totalItems:a.length,favoritesCount:a.filter(function(x){return x.is_favorite===true}).length,totalOutfits:rows_('outfits').filter(function(x){return x.user_id===u.id}).length,totalValue:a.reduce(function(n,x){return n+Number(x.price||0)},0),averagePrice:a.length?a.reduce(function(n,x){return n+Number(x.price||0)},0)/a.length:0,byCategory:by,byCategoryValue:byValue,colorDistribution:Object.keys(colors).map(function(k){return {color:k,count:colors[k]}})}}
function outfits_(u){return rows_('outfits').filter(function(x){return x.user_id===u.id}).map(function(x){var o=outfit_(x);o.items=parsed_(x.items_json).map(function(i){var c=find_('items','id',i.clothingItemId);return Object.assign({},i,{clothingItem:c?item_(c):null})});return o})}
function outfitCreate_(b,u){var r={id:Utilities.getUuid(),user_id:u.id,name:b.name||'Outfit mới',thumbnail_url:b.thumbnail?saveImage_(b.thumbnail,'outfit-'+Date.now()+'.png'):'',items_json:JSON.stringify(b.items||[]),created_at:now_()};add_('outfits',r);return outfit_(r)}
function diary_(u){return rows_('diary').filter(function(x){return x.user_id===u.id}).map(function(x){return {id:x.id,userId:x.user_id,outfitId:x.outfit_id,wearDate:x.wear_date,createdAt:x.created_at}})}
function diaryUpsert_(b,u){var old=rows_('diary').find(function(x){return x.user_id===u.id&&x.wear_date===b.wearDate});var r={id:old?old.id:Utilities.getUuid(),user_id:u.id,outfit_id:b.outfitId,wear_date:b.wearDate,created_at:old?old.created_at:now_()};old?update_('diary',r.id,r):add_('diary',r);return r}
function trips_(u){return rows_('trips').filter(function(x){return x.user_id===u.id}).map(function(x){var t={id:x.id,userId:u.id,name:x.name,startDate:x.start_date,endDate:x.end_date,destination:x.destination,createdAt:x.created_at,items:[]};t.items=rows_('trip_items').filter(function(i){return i.trip_id===x.id}).map(function(i){var c=find_('items','id',i.clothing_item_id);return {id:i.id,tripId:i.trip_id,clothingItemId:i.clothing_item_id,packed:i.packed===true,clothingItem:c?item_(c):null}});return t})}
function tripCreate_(b,u){var r={id:Utilities.getUuid(),user_id:u.id,name:b.name,start_date:b.startDate,end_date:b.endDate,destination:b.destination,created_at:now_()};add_('trips',r);return {id:r.id,userId:u.id,name:r.name,startDate:r.start_date,endDate:r.end_date,destination:r.destination,createdAt:r.created_at,items:[]}}
function tripItemAdd_(b,u){owned_('trips',b.tripId,u.id);var r={id:Utilities.getUuid(),trip_id:b.tripId,clothing_item_id:b.clothingItemId,packed:false};add_('trip_items',r);var c=find_('items','id',r.clothing_item_id);return {id:r.id,tripId:r.trip_id,clothingItemId:r.clothing_item_id,packed:false,clothingItem:c?item_(c):null}}
function tripItemDelete_(id,uid){var r=find_('trip_items','id',id);if(!r||!owned_('trips',r.trip_id,uid))throw Error('Trip item not found.');return del_('trip_items',id)}
function tripItemToggle_(id,uid){var r=find_('trip_items','id',id);if(!r||!owned_('trips',r.trip_id,uid))throw Error('Trip item not found.');r.packed=r.packed!==true;update_('trip_items',id,r);return {id:r.id,tripId:r.trip_id,clothingItemId:r.clothing_item_id,packed:r.packed}}
function require_(t){var s=find_('sessions','token',t);if(!s||new Date(s.expires_at).getTime()<Date.now())throw Error('Unauthorized.');var u=find_('users','id',s.user_id);if(!u)throw Error('User not found.');return u}
function owned_(t,id,uid){var r=find_(t,'id',id);if(!r||(r.user_id&&r.user_id!==uid))throw Error('Record not found.');return r}
function deleteOwned_(t,id,uid){owned_(t,id,uid);return del_(t,id)}
function user_(x){return {id:x.id,email:x.email,name:x.name||null,avatarUrl:x.avatar_url||null,createdAt:x.created_at}}
function closet_(x){return {id:x.id,userId:x.user_id,name:x.name,isDefault:x.is_default===true,createdAt:x.created_at}}
function item_(x){return {id:x.id,userId:x.user_id,name:x.name,category:x.category,color:x.color||null,brand:x.brand||null,season:x.season||null,tags:parsed_(x.tags_json),originalImageUrl:x.original_image_url,processedImageUrl:x.processed_image_url||null,processingStatus:x.processing_status||'done',purchaseUrl:x.purchase_url||null,price:x.price===''?null:Number(x.price),purchasedAt:x.purchased_at||null,isFavorite:x.is_favorite===true,condition:x.condition||'new',notes:x.notes||null,closetId:x.closet_id||null,createdAt:x.created_at,updatedAt:x.updated_at}}
function outfit_(x){return {id:x.id,userId:x.user_id,name:x.name,thumbnailUrl:x.thumbnail_url||null,createdAt:x.created_at}}
function array_(x){return Array.isArray(x)?x:(x?String(x).split(',').map(function(v){return v.trim()}).filter(Boolean):[])}function parsed_(x){try{return x?JSON.parse(x):[]}catch(e){return []}}function snake_(x){return String(x).replace(/[A-Z]/g,function(m){return '_'+m.toLowerCase()})}
function saveImage_(d,n){if(!d||d.indexOf('data:')!==0)return d||'';var m=d.match(/^data:([^;]+);base64,(.*)$/);if(!m)return d;var blob=Utilities.newBlob(Utilities.base64Decode(m[2]),m[1],n);var cloud=uploadCloudinary_(blob,n);if(cloud)return cloud;var id=PropertiesService.getScriptProperties().getProperty('DRIVE_FOLDER_ID');return id?DriveApp.getFolderById(id).createFile(blob).getUrl():d}
function uploadCloudinary_(blob,n){var p=PropertiesService.getScriptProperties(),cloud=p.getProperty('CLOUDINARY_CLOUD_NAME'),key=p.getProperty('CLOUDINARY_API_KEY'),secret=p.getProperty('CLOUDINARY_API_SECRET');if(!cloud||!key||!secret)return '';var timestamp=Math.floor(Date.now()/1000),folder=p.getProperty('CLOUDINARY_FOLDER')||'drobe';var signature=sha1_('folder='+folder+'&timestamp='+timestamp+secret);try{var response=UrlFetchApp.fetch('https://api.cloudinary.com/v1_1/'+cloud+'/image/upload',{method:'post',payload:{file:blob,api_key:key,timestamp:timestamp,folder:folder,signature:signature},muteHttpExceptions:true});var data=JSON.parse(response.getContentText());return data.secure_url||''}catch(e){return ''}}
function sha1_(x){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_1,String(x),Utilities.Charset.UTF_8).map(function(b){return(b<0?b+256:b).toString(16).padStart(2,'0')}).join('')}
function sheet_(n){var s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(n);if(!s)s=SpreadsheetApp.getActiveSpreadsheet().insertSheet(n);if(s.getLastRow()===0)s.getRange(1,1,1,TABLES[n].length).setValues([TABLES[n]]);return s}
function rows_(n){var v=sheet_(n).getDataRange().getValues();if(v.length<2)return[];var h=v.shift().map(String);return v.filter(function(r){return r.some(function(c){return c!==''})}).map(function(r){var o={};h.forEach(function(k,i){var x=r[i];if(x==='true')x=true;if(x==='false')x=false;o[k]=x});return o})}
function find_(t,k,v){return rows_(t).find(function(x){return String(x[k]||'').toLowerCase()===String(v||'').toLowerCase()})||null}function add_(t,o){var h=TABLES[t];sheet_(t).appendRow(h.map(function(k){return o[k]===undefined||o[k]===null?'':o[k]}))}
function update_(t,id,o){var s=sheet_(t),v=s.getDataRange().getValues(),h=v.shift().map(String),ix=h.indexOf('id');for(var i=0;i<v.length;i++)if(String(v[i][ix])===String(id)){s.getRange(i+2,1,1,h.length).setValues([h.map(function(k){return o[k]===undefined||o[k]===null?'':o[k]})]);return}}function del_(t,id){var s=sheet_(t),v=s.getDataRange().getValues(),h=v.shift().map(String),ix=h.indexOf('id');for(var i=v.length-1;i>=0;i--)if(String(v[i][ix])===String(id)){s.deleteRow(i+2);return {success:true}}throw Error('Record not found.')}
function hash_(x){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(x),Utilities.Charset.UTF_8).map(function(b){return(b<0?b+256:b).toString(16).padStart(2,'0')}).join('')}function now_(){return new Date().toISOString()}function out_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
